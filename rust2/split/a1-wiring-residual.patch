-        return bits;
-      };
-      const bool who[3] = {who_u, who_g, who_o};
-      for (int cls = 0; cls < 3; ++cls) {
-        if (!who[cls]) continue;
-        const int shift = 6 - 3 * cls;
-        const unsigned bits = class_bits(cls);
