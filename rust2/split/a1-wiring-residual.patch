-                                  WTSIdleTime, &buffer, &size) &&
-      buffer != nullptr && size >= sizeof(DWORD)) {
-    memcpy(&value, buffer, sizeof(value));
-    result = value / 1000;
-  }
-  if (buffer) WTSFreeMemory(buffer);
-  return result;
